# Скопируй этот файл в .env.local и подставь реальные значения.
# .env.local не коммитится (см. .gitignore).

# Project URL из Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# publishable (anon) ключ Supabase — попадает в браузер
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# service role (secret) ключ Supabase — ТОЛЬКО на сервере, в клиент не попадает
SUPABASE_SECRET_KEY=eyJhbGciOi...

# Случайная строка для подписи cookie сессий (сгенерируй: openssl rand -hex 32)
SESSION_SECRET=замени_меня_на_случайную_строку

# (необязательно) Адрес сайта для корректных OpenGraph/канонических URL
NEXT_PUBLIC_SITE_URL=https://swv.example.com

# (необязательно) Пароль первого входа в админку. Если задан — именно он станет
# паролем админа, а не "первый введённый пароль". Защищает от перехвата админки
# сразу после деплоя. После первого входа можно убрать.
BOOTSTRAP_ADMIN_PASSWORD=
